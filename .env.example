# Öffentliche Website-URL (ohne Slash am Ende)
# In Vercel unter Project → Settings → Environment Variables setzen.
NEXT_PUBLIC_SITE_URL=https://www.wassana-thai-imbiss.de

# Optional: Google Search Console Verifizierungscode (meta-Tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Pflicht in Production: Passwort für /admin (starkes Passwort wählen)
ADMIN_PASSWORD=

# Optional: separates HMAC-Secret für Admin-Cookies (sonst = ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# E-Mail-Versand für Kontaktformular (SMTP)
# Beispiel IONOS: smtp.ionos.de / Port 587
# Beispiel iCloud: smtp.mail.me.com / Port 587 (App-Passwort nötig)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=deine@email.de
SMTP_PASS=dein-smtp-passwort
# Optional:
# SMTP_FROM=deine@email.de
# SMTP_FROM_NAME=Wassana Thai Imbiss
# CONTACT_TO=wassanathaiimbiss@icloud.de
# SMTP_SECURE=false

# Pflicht auf Vercel: speichert CMS-Daten dauerhaft im Repo
# (Kochkurs, Website-Texte, Wochenkarte, Betrieb — NICHT Kontakt-Anfragen/PII)
# Ohne Token: Admin-Speichern schlägt fehl (nur temporär wäre unsicher).
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=viastefan/Wassana
# GITHUB_BRANCH=main

# Web Push für Admin-App (Benachrichtigungen zu Kochkurs / News)
# Keys erzeugen: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:wassanathaiimbiss@icloud.de
