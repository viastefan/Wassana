# Öffentliche Website-URL (ohne Slash am Ende)
# In Vercel unter Project → Settings → Environment Variables setzen.
NEXT_PUBLIC_SITE_URL=https://www.wassana-thai-imbiss.de

# Optional: Google Search Console Verifizierungscode (meta-Tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Pflicht in Production: Passwort für /admin (starkes Passwort wählen)
ADMIN_PASSWORD=

# Optional: separates HMAC-Secret für Admin-Cookies (sonst = ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# E-Mail-Versand (SMTP) — Pflicht, damit Anfragen live per Mail ankommen
# Beispiel IONOS: smtp.ionos.de / Port 587
# Beispiel iCloud: smtp.mail.me.com / Port 587 (App-Passwort nötig)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=deine@email.de
SMTP_PASS=dein-smtp-passwort
# Optional:
# SMTP_FROM=deine@email.de
# SMTP_FROM_NAME=Wassana Thai Imbiss
# SMTP_SECURE=false
# Extra-Empfänger zusätzlich zu den festen Inboxes:
# CONTACT_TO=weitere@email.de
#
# Website-Anfragen gehen immer an:
#   stefandirnberger@viawen.com
#   wassanathaiimbiss@icloud.de
# (+ optional CONTACT_TO). Gäste bekommen eine Bestätigung.

# Live-CMS auf Vercel (Banner, Texte, Wochenkarte, Kochkurs, Betrieb)
# Wird automatisch gesetzt, wenn ein Vercel Blob Store am Projekt hängt.
# BLOB_READ_WRITE_TOKEN=

# Optional: GitHub-Backup der CMS-JSONs (nicht nötig für Live)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=viastefan/Wassana
# GITHUB_BRANCH=main

# Support / Passwort-Reset-Mails und Admin-Änderungs-Benachrichtigungen:
# stefandirnberger@viawen.com
# Optional überschreiben:
# ADMIN_NOTIFY_EMAIL=stefandirnberger@viawen.com

# Kontaktanfragen (PII) ebenfalls über Blob (verschlüsselt) wenn Token gesetzt.
# INQUIRIES_SECRET=

# Web Push für Admin-App (Anfragen + Kochkurs + News)
# Keys erzeugen: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:wassanathaiimbiss@icloud.de
